{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主面板与设置窗口的最小权限：核心窗口/通知/开机启动/外链，加全部应用命令的显式 allow",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-is-visible",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-resizable",
    "notification:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "opener:default",
    "allow-init-state",
    "allow-task-add",
    "allow-task-edit",
    "allow-task-set-due",
    "allow-task-toggle-done",
    "allow-task-delete",
    "allow-task-toggle-focus",
    "allow-task-clear-completed",
    "allow-task-move",
    "allow-history-undo",
    "allow-history-redo",
    "allow-auth-login",
    "allow-auth-register",
    "allow-auth-logout",
    "allow-sync-flush",
    "allow-sync-restore",
    "allow-conflict-choose-local",
    "allow-conflict-choose-cloud",
    "allow-conflict-defer",
    "allow-settings-update",
    "allow-settings-reset",
    "allow-system-open-settings",
    "allow-system-hide-main",
    "allow-system-toggle-mode",
    "allow-system-quit",
    "allow-system-save-now",
    "allow-system-data-path",
    "allow-system-reveal-data",
    "allow-system-notify-clicked",
    "allow-migration-import",
    "allow-data-export-legacy",
    "allow-launch-at-login-get",
    "allow-launch-at-login-set"
  ]
}
